{{ 'gift-guide.css' | asset_url | stylesheet_tag }}
<section class="gg-banner" style="
  {% if section.settings.bg_image != blank %}
    --gg-bg:url({{ section.settings.bg_image | image_url: width: 2400 }});
  {% endif %}
">
  <div class="gg-banner__inner">

    <!-- Top Header Row (Figma) -->
    <div class="gg-topbar">
      <div class="gg-topbar__inner">
        <div class="gg-brand">{{ section.settings.logo_text }}</div>

        <div class="gg-tagline">{{ section.settings.top_text }}</div>

        <a class="gg-btn gg-btn--choose" href="{{ section.settings.top_button_link }}">
          <span class="gg-btn__text">{{ section.settings.top_button_label }}</span>
          <span class="gg-btn__arrow">→</span>
        </a>
      </div>
    </div>



    <!-- Left Content -->
    <div class="gg-content">
      {% if section.settings.heading != blank %}
        <h1 class="gg-title">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="gg-desc">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.cta_label != blank %}
       <a class="gg-btn gg-btn--dark gg-animate-in" href="{{ section.settings.cta_link }}">
        <span class="gg-btn__text">{{ section.settings.cta_label }}</span>
        <span class="gg-btn__arrow">→</span>
      </a>

      {% endif %}
    </div>

    {% if section.settings.bottom_caption != blank %}
      <div class="gg-bottom-caption">{{ section.settings.bottom_caption }}</div>
    {% endif %}
  </div>
</section>
<script src="{{ 'gift-guide.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Gift Guide - Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },

    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "TISSO VISION" },
    { "type": "text", "id": "top_text", "label": "Top center text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "top_button_label", "label": "Top button label", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "top_button_link", "label": "Top button link" },

    { "type": "text", "id": "heading", "label": "Main heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination.\nExplore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },

    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "SHOP NOW" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },

    { "type": "text", "id": "bottom_caption", "label": "Bottom small caption", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [
    { "name": "Gift Guide - Banner" }
  ]
}
{% endschema %}
