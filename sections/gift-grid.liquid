{{ 'gift-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-guide.js' | asset_url }}" defer></script>

<section class="gg-grid">
  <div class="gg-grid__inner">
    <h2 class="gg-grid__title">{{ section.settings.title }}</h2>

    {% assign col = section.settings.collection %}
    {% if col == blank %}
      <p>Please select a collection in this section settings.</p>
    {% else %}
      <div class="gg-grid__wrap">
        {% for product in col.products limit: section.settings.limit %}
          {% assign first_variant = product.selected_or_first_available_variant %}

          <button
            class="gg-card"
            type="button"
            data-gg-product='{
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "url": {{ product.url | json }},
              "price": {{ first_variant.price | money | json }},
              "image": {{ product.featured_image | image_url: width: 800 | json }},
              "variants": {{ product.variants | json }},
              "options": {{ product.options_with_values | json }},
              "description": {{ product.description | strip_html | truncate: 140 | json }}
            }'
          >
            <div class="gg-card__img">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                >
              {% endif %}
              <span class="gg-card__plus">+</span>
            </div>
            <div class="gg-card__meta">
              <div class="gg-card__title">{{ product.title }}</div>
              <div class="gg-card__price">{{ first_variant.price | money }}</div>
            </div>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- Figma-style Modal -->
  <div class="gg-modal" hidden>
    <div class="gg-modal__overlay" data-gg-close></div>

    <div class="gg-modal__panel" role="dialog" aria-modal="true" aria-label="Product options">
      <button class="gg-modal__close" type="button" aria-label="Close" data-gg-close>×</button>

      <div class="gg-modal__body">
        <div class="gg-modal__img">
          <img src="" alt="" />
        </div>

        <div class="gg-modal__info">
          <div class="gg-modal__title"></div>
          <div class="gg-modal__price"></div>
          <div class="gg-modal__desc"></div>

          <div class="gg-modal__opts"></div>

          <button class="gg-btn gg-btn--add" type="button" data-gg-add>
            <span class="gg-btn__text">ADD TO CART</span>
            <span class="gg-btn__arrow">→</span>
          </button>

          <div class="gg-modal__msg" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide - Products",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 3, "max": 24, "step": 1, "label": "Products limit", "default": 9 }
  ],
  "presets": [{ "name": "Gift Guide - Products" }]
}
{% endschema %}
